# No dependency gets to run code at install time.
#
# Nothing here needs to: the only packages in the tree with an install hook are
# IBM's two Plex font packages, and what theirs runs is `ibmtelemetry`, which
# reports the install to IBM. A font is a file; fetching it should not tell
# anyone that this server was built, and a build machine should not run code it
# never asked for. `npm run build` and the other named scripts are unaffected.
ignore-scripts=true
