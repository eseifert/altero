{
  "name": "altero-web",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Web interface for altero",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build",
    "e2e": "playwright test",
    "e2e:registration": "playwright test --config playwright.registration.config.ts",
    "i18n:check": "node scripts/check-locales.test.ts && node scripts/check-locales.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "dompurify": "^3.4.17",
    "pinia": "^4.0.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-sans-arabic": "^1.1.0",
    "@ibm/plex-sans-hebrew": "^1.1.0",
    "@ibm/plex-sans-jp": "^3.0.0",
    "@intlify/message-compiler": "^11.4.16",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.25",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.6"
    },
    "minimatch": "^11.0.8"
  }
}
